{
  "buildCommand": "cd frontend && CI=false npm install && CI=false npm run build",
  "outputDirectory": "frontend/build",
  "env": {
    "REACT_APP_API_URL": "https://mediq-backend-vcus.onrender.com/api/v1",
    "REACT_APP_SOCKET_URL": "https://mediq-backend-vcus.onrender.com",
    "REACT_APP_NAME": "MedIQ - Healthcare Portal",
    "REACT_APP_VERSION": "2.0.0",
    "CI": "false"
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
