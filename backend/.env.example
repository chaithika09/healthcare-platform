# ============================================================
# Smart Healthcare Portal — Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
NODE_ENV=production
PORT=5000
APP_NAME=Smart Healthcare Portal
APP_URL=https://mediq-healthcare.vercel.app
API_URL=https://mediq-backend.onrender.com

# ── MongoDB ───────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/healthcare_db
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/healthcare_db
MONGODB_URI=mongodb://localhost:27017/healthcare_db
MONGODB_TEST_URI=mongodb://localhost:27017/healthcare_db_test

# ── JWT Authentication ────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_REFRESH_EXPIRES_IN=30d

# ── Password Hashing ─────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ── Email (SMTP) ──────────────────────────────────────────────
# For development use Mailtrap: https://mailtrap.io
# For production use SendGrid, AWS SES, or similar
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM_NAME=Smart Healthcare Portal
EMAIL_FROM_ADDRESS=noreply@smarthealthcare.com

# ── File Uploads ──────────────────────────────────────────────
# Local storage or cloud (S3, Cloudinary, etc.)
UPLOAD_PROVIDER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# AWS S3 (if UPLOAD_PROVIDER=s3)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=healthcare-platform-uploads

# Cloudinary (if UPLOAD_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ── Socket.io ─────────────────────────────────────────────────
SOCKET_CORS_ORIGIN=http://localhost:3000

# ── Session / Cookie ─────────────────────────────────────────
SESSION_SECRET=your_session_secret_change_this_in_production
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# ── Pagination Defaults ───────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ── Appointment Settings ──────────────────────────────────────
APPOINTMENT_SLOT_DURATION_MINUTES=30
APPOINTMENT_REMINDER_HOURS_BEFORE=24

# ── Encryption (for sensitive medical data at rest) ───────────
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here
ENCRYPTION_IV_LENGTH=16

# ── External APIs (optional integrations) ────────────────────
# Google Maps (for clinic location)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Twilio (for SMS notifications)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Stripe (for payment processing)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── Feature Flags ─────────────────────────────────────────────
FEATURE_VIDEO_CONSULTATION=true
FEATURE_AI_SYMPTOM_CHECKER=false
FEATURE_PAYMENT_PROCESSING=false
FEATURE_SMS_NOTIFICATIONS=false
