# ── SERVER CONFIGURATION ──────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── DATABASE CONFIGURATION (MongoDB Atlas) ─────────────────────
# Replace with your Atlas connection string.
# Go to Atlas -> Cluster -> Connect -> Drivers -> copy connection string.
# Example: mongodb+srv://lschaithika:DemoPassword123@cluster0.abcde.mongodb.net/healthcare_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER_URL>/healthcare_db?retryWrites=true&w=majority

# ── SECURITY (JWT) ───────────────────────────────────────────
# Generate a long random string (e.g., using openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# ── EMAIL CONFIGURATION (SMTP / Gmail) ────────────────────────
# For Gmail: Use an App Password (Security -> 2FA -> App Passwords)
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=chaithikals09@gmail.com
SMTP_PASS=ylagpzhrvjcawgom
EMAIL_FROM_NAME=Smart Healthcare Portal
EMAIL_FROM_ADDRESS=chaithikals09@gmail.com

# ── FRONTEND CONNECTIVITY (CORS) ──────────────────────────────
# List of allowed origins separated by commas (no spaces)
CORS_ORIGINS=http://localhost:3000,https://healthcare-platform-lscha.vercel.app

# ── RATE LIMITING ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── FILE UPLOADS ──────────────────────────────────────────────
UPLOAD_PROVIDER=local
MAX_FILE_SIZE_MB=10
